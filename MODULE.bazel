"""Bazel module for the extending-bazel-with-starlark course monorepo.

A small Go monorepo: shared libraries under lib/, domain models under
internal/domain/, and three deployable binaries under cmd/. BUILD files are
generated by Gazelle (`bazel run //:gazelle`).
"""

module(
    name = "course",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.1")
