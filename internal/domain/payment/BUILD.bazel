load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "payment",
    srcs = [
        "links.go",
        "model.go",
        "repo.go",
        "validate.go",
    ],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/internal/domain/payment",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/domain/refund",
        "//internal/domain/settlement",
        "//lib/codec",
        "//lib/log",
        "//lib/metrics",
        "//lib/schema",
        "//lib/store",
        "//lib/validate",
    ],
)

go_test(
    name = "payment_test",
    size = "small",
    srcs = ["payment_test.go"],
    embed = [":payment"],
    deps = [
        "//lib/codec",
        "//lib/config",
        "//lib/log",
        "//lib/store",
    ],
)
