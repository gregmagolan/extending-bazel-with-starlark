load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "catalog",
    srcs = [
        "links.go",
        "model.go",
        "validate.go",
    ],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/internal/domain/catalog",
    visibility = ["//:__subpackages__"],
