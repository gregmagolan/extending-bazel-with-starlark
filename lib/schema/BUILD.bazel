load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "schema",
    srcs = ["schema.go"],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/lib/schema",
    visibility = ["//visibility:public"],
