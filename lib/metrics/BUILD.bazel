load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "metrics",
    srcs = ["metrics.go"],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/lib/metrics",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/clock",
        "//lib/log",
    ],
)

go_test(
    name = "metrics_test",
    size = "small",
    srcs = ["metrics_test.go"],
    embed = [":metrics"],
    deps = ["//lib/log"],
)
