load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "worker_lib",
    srcs = [
        "handler.go",
        "main.go",
    ],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/cmd/worker",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/domain/audit",
        "//internal/domain/billing",
        "//internal/domain/inventory",
        "//internal/domain/notification",
        "//internal/domain/payment",
        "//internal/domain/session",
        "//internal/domain/shipping",
        "//internal/domain/webhook",
        "//lib/codec",
        "//lib/config",
        "//lib/log",
        "//lib/metrics",
        "//lib/queue",
        "//lib/retry",
        "//lib/store",
    ],
)

go_binary(
    name = "worker",
    embed = [":worker_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "worker_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":worker_lib"],
    deps = [
        "//lib/codec",
        "//lib/config",
        "//lib/log",
        "//lib/queue",
        "//lib/retry",
        "//lib/store",
    ],
)
