load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@tar.bzl", "tar")

go_library(
    name = "worker_lib",
    srcs = [
        "handler.go",
        "main.go",
    ],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/cmd/worker",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/domain/audit",
        "//internal/domain/billing",
        "//internal/domain/inventory",
        "//internal/domain/notification",
        "//internal/domain/payment",
        "//internal/domain/session",
        "//internal/domain/shipping",
        "//internal/domain/webhook",
        "//lib/codec",
        "//lib/config",
        "//lib/log",
        "//lib/metrics",
        "//lib/queue",
        "//lib/retry",
        "//lib/store",
    ],
)

go_binary(
    name = "worker",
    embed = [":worker_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "worker_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":worker_lib"],
    deps = [
        "//lib/codec",
        "//lib/config",
        "//lib/log",
        "//lib/queue",
        "//lib/retry",
        "//lib/store",
    ],
)

go_cross_binary(
    name = "worker_linux",
    platform = "@rules_go//go/toolchain:linux_amd64",
    target = ":worker",
)

tar(
    name = "worker_layer",
    srcs = [":worker_linux"],
    include_runfiles = False,
)

oci_image(
    name = "image",
    architecture = "amd64",
    entrypoint = ["/cmd/worker/worker_linux"],
    exposed_ports = ["8081/tcp"],
    labels = {
        "org.opencontainers.image.title": "worker",
    },
    os = "linux",
    tars = [":worker_layer"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["1h"],
    repository = "ttl.sh/worker",
)
