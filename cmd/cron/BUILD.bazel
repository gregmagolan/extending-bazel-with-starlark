load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@tar.bzl", "tar")

go_library(
    name = "cron_lib",
    srcs = ["main.go"],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/cmd/cron",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/clock",
        "//lib/config",
        "//lib/log",
    ],
)

go_binary(
    name = "cron",
    embed = [":cron_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "cron_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":cron_lib"],
)

go_cross_binary(
    name = "cron_linux",
    platform = "@rules_go//go/toolchain:linux_amd64",
    target = ":cron",
)

tar(
    name = "cron_layer",
    srcs = [":cron_linux"],
    include_runfiles = False,
)

oci_image(
    name = "image",
    architecture = "amd64",
    entrypoint = ["/cmd/cron/cron_linux"],
    exposed_ports = ["8082/tcp"],
    labels = {
        "org.opencontainers.image.title": "cron",
    },
    os = "linux",
    tars = [":cron_layer"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["1h"],
    repository = "ttl.sh/cron",
)
