load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@tar.bzl", "tar")

go_library(
    name = "server_lib",
    srcs = [
        "main.go",
        "store.go",
    ],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/api",
        "//lib/auth",
        "//lib/codec",
        "//lib/config",
        "//lib/log",
        "//lib/metrics",
        "//lib/queue",
        "//lib/store",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":server_lib"],
)

go_cross_binary(
    name = "server_linux",
    platform = "@rules_go//go/toolchain:linux_amd64",
    target = ":server",
)

tar(
    name = "server_layer",
    srcs = [":server_linux"],
    include_runfiles = False,
)

oci_image(
    name = "image",
    architecture = "amd64",
    entrypoint = ["/cmd/server/server_linux"],
    exposed_ports = ["8080/tcp"],
    labels = {
        "org.opencontainers.image.title": "server",
    },
    os = "linux",
    tars = [":server_layer"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["1h"],
    repository = "ttl.sh/server",
)
