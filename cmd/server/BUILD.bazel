load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "server_lib",
    srcs = [
        "main.go",
        "store.go",
    ],
    importpath = "github.com/gregmagolan/extending-bazel-with-starlark/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/api",
        "//lib/auth",
        "//lib/codec",
        "//lib/config",
        "//lib/log",
        "//lib/metrics",
        "//lib/queue",
        "//lib/store",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":server_lib"],
)
